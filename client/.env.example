# ==============================================================================
# Urban Maharaja Client — Environment Configuration Template
# Vite automatically exposes variables prefixed with VITE_ to the browser.
# ==============================================================================

# Backend API Endpoint
# In local development: http://localhost:5000/api/v1
# In production on Render: https://urban-maharaja-loyalty.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Application Name
VITE_APP_NAME="Urban Maharaja — Royal Loyalty Platform"

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
