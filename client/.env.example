# ==============================================================================
# Urban Maharaja Client — Environment Configuration Template
# Vite automatically exposes variables prefixed with VITE_ to the browser.
# ==============================================================================

# Backend API Endpoint
# In local development: http://localhost:5000/api/v1
# In production on Render: https://urban-maharaja-loyalty.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Application Name
VITE_APP_NAME="Urban Maharaja — Royal Loyalty Platform"

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Public Digital Menu site — opened by the "Explore Digital Menu" buttons.
# Use the menu project's PRODUCTION domain, NOT a per-deployment URL
# (e.g. ...-hbi32srb0.vercel.app). Deployment URLs sit behind Vercel login,
# so they ask customers on mobile to sign in.
# Where to find it: Vercel → menu project → Settings → Domains → copy the domain.
# Then set it here AND in Vercel → this website's project → Settings →
# Environment Variables (Production), and redeploy.
VITE_MENU_URL=https://your-menu-project.vercel.app/

# Public URL of THIS website — used for SEO canonical links, sitemap.xml and
# social share previews. Optional on Vercel: if empty, the build uses the
# project's production domain automatically.
VITE_SITE_URL=https://your-website-domain.com
