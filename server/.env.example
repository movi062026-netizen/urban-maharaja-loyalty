NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/urban-maharaja

# Production refuses to start unless both are random, 32+ chars and different. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CLIENT_URL=http://localhost:5173

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REVIEW_URL=REPLACE_WITH_GOOGLE_REVIEW_URL
GOOGLE_MAPS_URL=REPLACE_WITH_GOOGLE_MAPS_URL
RESERVATION_URL=REPLACE_WITH_RESERVATION_URL

UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

LOG_LEVEL=info

# ── Email (currently NOT used) ───────────────────────────────────────────────
# Email OTP login and Forgot Password are switched off until a sending domain /
# verified sender is set up. Nothing needs to be set here, locally or on Render.
# Re-enable these when those features come back.
# RESEND_API_KEY=re_your_resend_api_key_here
# RESEND_FROM="Urban Maharaja <noreply@your-domain.com>"

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Used only by `npm run create-admin` (one-time admin provisioning). Do not keep these in a deployed .env.
# ADMIN_NAME=Owner Name
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=

# ── Web Push (phone/desktop notifications even when the site is closed) ──────
# These are NOT URLs from any website — you generate them yourself, once, for free.
#
# HOW TO GET THEM:
#   1. Open a terminal in the `server` folder.
#   2. Run:   npx web-push generate-vapid-keys
#   3. It prints two values:
#        Public Key:  BExxxx...   (about 87 characters)  -> WEB_PUSH_PUBLIC_KEY
#        Private Key: xxxx...     (about 43 characters)  -> WEB_PUSH_PRIVATE_KEY
#   4. WEB_PUSH_SUBJECT is just a contact address for the push services,
#      written as "mailto:" + any email you own (or your website https:// URL).
#
# IMPORTANT:
#   - Generate ONCE and use the SAME pair everywhere (local .env AND Render).
#     If you change them later, every device has to turn notifications on again.
#   - Keep WEB_PUSH_PRIVATE_KEY secret (never commit it or put it in the client).
#   - On Render: Dashboard -> your API service -> Environment -> Add the 3 variables.
#   - Already set up locally? Your current values are in server/.env — copy those to Render.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com
